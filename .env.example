PORT=3000
NODE_ENV=development

# Database Configuration
# Supported drivers: 'mysql' or 'sqlite'
# If 'mysql' is selected but server is unreachable, system safely falls back to 'sqlite'
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_inventory_db

# JWT Authentication
JWT_SECRET=inventory_management_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=24h
